# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# In production, inject these from your host's secret store instead of a file.

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=MP3 Track Splitter
# Absolute URL of the deployment, used for canonical/OpenGraph URLs
NEXT_PUBLIC_SITE_URL=
# Linked from the open-source notice; point forks at their own repo
NEXT_PUBLIC_SOURCE_URL=

# --- Storage for finished tracks/zips ----------------------------------------
# 'local' writes to ./generated/audio-split/_store (no AWS needed); anything else uses S3
SPLIT_TRACK_STORAGE=local
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- reCAPTCHA v2 (checkbox) -------------------------------------------------
NEXT_PUBLIC_REACT_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Local dev only (ignored when NODE_ENV=production): skip the captcha on both sides
SKIP_CAPTCHA=true
NEXT_PUBLIC_SKIP_CAPTCHA=true

# --- Debugging --------------------------------------------------------------
SPLIT_TRACK_FFMPEG_VERBOSE=false
