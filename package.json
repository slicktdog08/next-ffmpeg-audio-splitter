{
    "name": "next-ffmpeg-audio-splitter",
    "version": "1.0.0",
    "private": true,
    "description": "Split one long MP3 into tagged tracks with cover art \u2014 Next.js + ffmpeg.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slicktdog08/next-ffmpeg-audio-splitter.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
        "test": "jest",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:update-snapshots": "playwright test --update-snapshots",
        "e2e:report": "playwright show-report e2e/.results/html"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.11.2",
        "archiver": "^7.0.1",
        "aws-sdk": "^2.1690.0",
        "fluent-ffmpeg": "^2.1.3",
        "next": "16.2.1",
        "node-id3": "^0.2.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-redux": "9.2.0",
        "reaptcha": "^1.12.1",
        "redux": "4.1.2",
        "redux-devtools-extension": "2.13.9",
        "redux-persist": "^6.0.0",
        "wavesurfer.js": "^7.8.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.1.15",
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^6.0.2",
        "@types/fluent-ffmpeg": "^2.1.26",
        "@types/jest": "^29.5.13",
        "@types/node": "20.9.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "adm-zip": "^0.6.1",
        "jest": "^29.7.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.15",
        "ts-jest": "^29.2.5",
        "typescript": "5.9.3"
    },
    "prettier": {
        "semi": false,
        "trailingComma": "es5",
        "singleQuote": true,
        "printWidth": 120,
        "tabWidth": 4
    },
    "resolutions": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3"
    }
}
